{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "test": "tsc -p . && node --test \"dist/**/*.test.js\"",
    "test:integration": "tsc -p . && node --test \"dist/**/*.integration.js\""
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@app/db": "workspace:*",
    "@app/ledger": "workspace:*",
    "@app/money": "workspace:*",
    "@app/reports": "workspace:*",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@clerk/backend": "3.29.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/throttler": "6.7.1",
    "@sentry/nestjs": "^11.12.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.1"
  }
}
