#!/bin/sh
# Local CI gate (ADR 0007): the same steps as .github/workflows/ci.yml, run before every push.
# A red step blocks the push. Needs Docker for the integration tests.
set -e
echo "pre-push: running local CI (lint, typecheck, unit, integration, build)"
pnpm install --frozen-lockfile
pnpm lint
pnpm typecheck
pnpm test
pnpm test:integration
pnpm build
echo "pre-push: all green"
