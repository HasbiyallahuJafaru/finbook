{
  "name": "finbook",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "test:integration": "turbo run test:integration",
    "db:new": "pnpm --filter @app/db exec drizzle-kit generate --custom --name",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate": "pnpm --filter @app/db migrate",
    "openapi": "pnpm --filter @app/contracts openapi"
  },
  "engines": {
    "node": ">=24"
  }
}
