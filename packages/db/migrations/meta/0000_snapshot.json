      "checkConstraints": {
        "journal_lines_one_side": {
          "name": "journal_lines_one_side",
          "value": "\"journal_lines\".\"debit_ngn\" >= 0 and \"journal_lines\".\"credit_ngn\" >= 0 and (\"journal_lines\".\"debit_ngn\" > 0) <> (\"journal_lines\".\"credit_ngn\" > 0)"
        },
        "journal_lines_fx": {
          "name": "journal_lines_fx",
          "value": "coalesce(case when \"journal_lines\".\"currency\" = 'NGN'\n    then \"journal_lines\".\"rate\" is null and \"journal_lines\".\"rate_source\" is null and \"journal_lines\".\"amount_minor\" = \"journal_lines\".\"debit_ngn\" + \"journal_lines\".\"credit_ngn\"\n    else \"journal_lines\".\"rate\" > 0 and \"journal_lines\".\"amount_minor\" > 0\n      and \"journal_lines\".\"rate_source\" in ('bank_receipt', 'bdc_receipt', 'agent_invoice', 'manual')\n      and (\"journal_lines\".\"rate_source\" <> 'manual' or \"journal_lines\".\"rate_note\" is not null)\n      and \"journal_lines\".\"debit_ngn\" + \"journal_lines\".\"credit_ngn\" = round(\"journal_lines\".\"amount_minor\" * \"journal_lines\".\"rate\")\n    end, false)"
        }
      },
