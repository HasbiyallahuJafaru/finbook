      "checkConstraints": {
        "journal_lines_one_side": {
          "name": "journal_lines_one_side",
          "value": "\"journal_lines\".\"debit_ngn\" >= 0 and \"journal_lines\".\"credit_ngn\" >= 0 and (\"journal_lines\".\"debit_ngn\" > 0) <> (\"journal_lines\".\"credit_ngn\" > 0)"
        },
        "journal_lines_spot": {
          "name": "journal_lines_spot",
          "value": "coalesce(case\n    when \"journal_lines\".\"currency\" = 'NGN' then \"journal_lines\".\"spot_rate\" is null and \"journal_lines\".\"spot_source\" is null\n    else (\"journal_lines\".\"spot_rate\" is null) = (\"journal_lines\".\"spot_source\" is null) and (\"journal_lines\".\"spot_rate\" is null or (\"journal_lines\".\"spot_rate\" > 0 and \"journal_lines\".\"spot_source\" in ('cbn', 'manual')))\n    end and (\"journal_lines\".\"spot_source\" is distinct from 'manual' or btrim(\"journal_lines\".\"rate_note\") <> ''), false)"
        },
        "journal_lines_fx": {
          "name": "journal_lines_fx",
          "value": "coalesce(case when \"journal_lines\".\"currency\" = 'NGN'\n    then \"journal_lines\".\"rate\" is null and \"journal_lines\".\"rate_source\" is null and \"journal_lines\".\"amount_minor\" = \"journal_lines\".\"debit_ngn\" + \"journal_lines\".\"credit_ngn\"\n    else \"journal_lines\".\"rate\" > 0 and \"journal_lines\".\"amount_minor\" > 0\n      and \"journal_lines\".\"rate_source\" in ('bank_receipt', 'bdc_receipt', 'agent_invoice', 'manual', 'pool_average', 'payable_average')\n      and (\"journal_lines\".\"rate_source\" <> 'manual' or btrim(\"journal_lines\".\"rate_note\") <> '')\n      and case when \"journal_lines\".\"rate_source\" in ('pool_average', 'payable_average')\n        then \"journal_lines\".\"rate\" = round((\"journal_lines\".\"debit_ngn\" + \"journal_lines\".\"credit_ngn\")::numeric / \"journal_lines\".\"amount_minor\", 6)\n        else \"journal_lines\".\"debit_ngn\" + \"journal_lines\".\"credit_ngn\" = round(\"journal_lines\".\"amount_minor\" * \"journal_lines\".\"rate\")\n      end\n    end, false)"
        }
      },
